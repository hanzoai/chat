{
  "name": "@hanzochat/client",
  "version": "0.4.53",
  "description": "React components for Hanzo Chat",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/chat"
  },
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "b:clean": "bun run rimraf dist",
    "build": "npm run clean && rollup -c --bundleConfigAsCjs",
    "build:dev": "npm run clean && NODE_ENV=development rollup -c --bundleConfigAsCjs",
    "b:build": "bun run b:clean && bun run rollup -c --silent --bundleConfigAsCjs",
    "build:watch": "rollup -c -w --bundleConfigAsCjs",
    "dev": "rollup -c -w --bundleConfigAsCjs"
  },
