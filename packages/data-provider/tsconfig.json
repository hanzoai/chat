{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist/types",
    "module": "esnext",
    "noImplicitAny": true,
    "outDir": "./types",
    "target": "es5",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "lib": ["es2017", "dom", "ES2021.String"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "sourceMap": true,
    // baseUrl is what makes a bare "src/..." specifier resolvable. Without it
    // TypeScript has no root to resolve non-relative paths against, so
    // src/types/assistants.ts fails with
    //   TS2307: Cannot find module 'src/schemas'
    // even though src/schemas.ts is right there — and rollup-plugin-typescript2
    // turns that into a hard RollupError that fails the whole image build.
    // "paths" was already here and worked, because paths entries resolve
    // relative to the config file rather than baseUrl.
    //
    // Deleted TWICE now, both times by an automated tsconfig migration calling
    // itself semantics-preserving. It is not:
    //   1266c6b9c -> the v1.0.49 image build died on exactly the TS2307 above.
    //   c07a00d1f -> "idempotent and semantics-preserving"; the v1.0.50 build
    //                died on exactly the TS2307 above, and the deletion took
    //                THIS COMMENT with it, so the next migration would have had
    //                nothing to read.
    // If a migration wants this line gone it must first make `pnpm run frontend`
    // pass without it. Nothing else is evidence.
    "baseUrl": ".",
    "paths": {
      "@hanzochat/data-provider/react-query": ["./src/react-query/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "types", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "include": ["src/**/*", "types/index.d.ts", "types/react-query/index.d.ts"]
}
