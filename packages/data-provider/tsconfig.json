{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./dist/types",
    "module": "esnext",
    "noImplicitAny": true,
    "outDir": "./types",
    // TS7 removed target=ES5 (TS5108). noEmit + an explicit lib list mean
    // target only shapes checking here; lib carries es2018 so AsyncGenerator
    // (zap.ts) resolves under both toolchains.
    "target": "es2017",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "lib": ["es2018", "dom", "ES2021.String"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "sourceMap": true,
    // Bare "src/..." specifiers used to resolve through baseUrl, which TS7
    // refuses outright (TS5102) — and two "semantics-preserving" migrations
    // (1266c6b9c, c07a00d1f) deleted baseUrl without a replacement, each killing
    // the image build with
    //   TS2307: Cannot find module 'src/schemas'
    // (rollup-plugin-typescript2 turns that into a hard RollupError). The
    // "src/*" paths entry below IS the replacement: paths resolve relative to
    // this config file, so it satisfies TS 5 and TS 7 alike. The bar from the
    // baseUrl era stands: `pnpm run frontend` passing without baseUrl is the
    // only evidence that counts.
    "paths": {
      "@hanzochat/data-provider/react-query": ["./src/react-query/index.ts"],
      "src/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "types", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "include": ["src/**/*", "types/index.d.ts", "types/react-query/index.d.ts"]
}
