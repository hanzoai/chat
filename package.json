{
  "name": "@hanzo/chat",
  "version": "1.0.8",
  "type": "module",
  "license": "MIT",
  "description": "Hanzo Chat \u2014 the client, on @hanzo/gui + @hanzo/ui.",
  "packageManager": "pnpm@11.24.0",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pack:lib": "tsc -p tsconfig.build.json",
    "prepack": "pnpm pack:lib",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hanzo/ai": "catalog:",
    "@hanzo/font": "catalog:",
    "@hanzo/gui": "catalog:",
    "@hanzo/iam": "catalog:",
    "@hanzo/ui": "catalog:",
    "@hanzogui/lucide-icons-2": "catalog:",
    "@hanzogui/next-theme": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-markdown": "catalog:",
    "react-native-web": "catalog:",
    "react-router": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@hanzo/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
