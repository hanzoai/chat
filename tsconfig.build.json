{
  // What ships. The app's own config never emits, because the app is bundled
  // from source; a package that another project installs has to hand it real
  // files and real declarations, since no resolver compiles TypeScript found
  // inside node_modules.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Source names the file it means, so `node --test` can run it straight; on
    // emit the same specifier becomes the `.js` beside it, which is the only
    // spelling Node resolves in a package.
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
